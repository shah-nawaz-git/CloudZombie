# Provider mode: demo or live
CLOUDZOMBIE_MODE=demo
# SQLAlchemy database URL
DATABASE_URL=sqlite:///./cloudzombie.db
# Optional AWS profile; credentials remain managed by the AWS SDK
AWS_PROFILE=
# Optional comma-separated region selection; blank means all accessible regions
AWS_REGION_SELECTION=
# Pricing cache lifetime in seconds
PRICING_CACHE_TTL=86400
# Comma-separated browser origins
CLOUDZOMBIE_CORS_ORIGINS=http://localhost:3000
# Seed demo history on first start
CLOUDZOMBIE_DEMO_SEED=true
# Optional override for the demo fixture path
CLOUDZOMBIE_DEMO_FIXTURE=
# Application log level
CLOUDZOMBIE_LOG_LEVEL=INFO
